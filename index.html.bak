<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Poems</title>
  <link rel="stylesheet" href="base.css">
  <style>
    body { font-family: var(--font-sans, system-ui, sans-serif); margin: 0; padding: 0; background: var(--bg-color, #fafafa); color: var(--text-color, #222); }
    .navbar { display: flex; justify-content: center; background: var(--navbar-bg, #0066cc); padding: 1rem 0; }
    .navbar a { color: var(--navbar-link-color, #fff); text-decoration: none; margin: 0 1.5rem; font-weight: 500; }
    .navbar a:hover { opacity: 0.8; }
    .container { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    h1 { text-align: center; color: var(--heading-color, #0066cc); }
    .poem { white-space: pre-line; font-size: 1.1rem; line-height: 1.6; background: var(--poem-bg, #fff8f0); padding: 1.5rem; border-radius: 8px; }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="jarvis.html">Poem about Jarvis</a>
    <a href="harith.html">Poem about Harith</a>
  </nav>
  <div class="container">
    <h1>Choose a poem</h1>
    <p>Use the navigation above to read a poem about Jarvis or a poem about Harith.</p>
  </div>
</body>
</html>
